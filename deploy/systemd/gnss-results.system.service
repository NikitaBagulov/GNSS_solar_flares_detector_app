[Unit]
Description=GNSS solar flare results catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/app/GNSS_solar_flares_detector_app
ExecStart=/home/user/app/GNSS_solar_flares_detector_app/.venv/bin/python results_server.py --directory results --bind 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
